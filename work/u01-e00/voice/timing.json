   "id": "hook",
   "s": 0.0,
   "e": 2.76,
   "text": "אבא הבטיח: אם ייבחר, יוריד מיסים."
  },
  {
   "id": "res",
   "s": 2.92,
   "e": 5.24,
   "text": "הוא לא נבחר, והמיסים עלו."
  },
  {
   "id": "q",
   "s": 5.74,
   "e": 6.68,
   "text": "אז הוא שיקר?"
  },
  {
   "id": "no",
   "s": 7.88,
   "e": 10.58,
   "text": "לא. וגם אם הם היו יורדים, אותו דבר."
  },
  {
   "id": "chk",
   "s": 10.7,
   "e": 13.02,
   "text": "אם לא נבחר, אין מה לבדוק."
  },
  {
   "id": "lead",
   "s": 13.18,
   "e": 15.92,
   "text": "אז מתי הבטחה כן נשברת?"
  },
  {
   "id": "pay",
   "s": 16.22,
   "e": 20.56,
   "text": "הבטחה ״אם p אז q״ נשברת רק כש-p קרה ו-q לא."
  },
  {
   "id": "unit",
   "s": 21.56,
   "e": 23.12,
   "text": "ביחידה הזאת נבנה את הכלל המדויק."
  },
  {
   "id": "loop",
   "s": 23.88,
   "e": 24.76,
   "text": "אז תגידו לי:"
  }
