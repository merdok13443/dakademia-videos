{
 "lines": [
  {
   "id": "h1",
   "s": 0.0,
   "e": 2.76,
   "text": "ארבע תוספות בדוכן, כמה פיתות שונות?"
  },
  {
   "id": "g2",
   "s": 3.56,
   "e": 5.78,
   "text": "שמונה? ארבע, כפול שתיים?"
  },
  {
   "id": "r3",
   "s": 6.46,
   "e": 8.64,
   "text": "בלוח אמת: שש עשרה."
  },
  {
   "id": "d4",
   "s": 9.44,
   "e": 13.86,
   "text": "חומוס, עם ובלי: שתיים, ארבע, שמונה, שש עשרה."
  },
  {
   "id": "m5",
   "s": 14.52,
   "e": 21.12,
   "text": "כל משתנה חדש מכפיל את מספר השורות: n משתנים, 2 בחזקת n שורות."
  },
  {
   "id": "v6",
   "s": 22.12,
   "e": 25.14,
   "text": "תוספת היא משתנה: T עם, F בלי."
  },
  {
   "id": "v7",
   "s": 25.64,
   "e": 27.22,
   "text": "ופיתה אחת היא שורה."
  },
  {
   "id": "l8",
   "s": 27.72,
   "e": 29.34,
   "text": "ועם עשרה משתנים?"
  },
  {
   "id": "p9",
   "s": 30.34,
   "e": 32.24,
   "text": "אלף עשרים וארבע שורות."
  },
  {
   "id": "r10",
   "s": 33.04,
   "e": 35.9,
   "text": "כל משתנה מכפיל: 2 בחזקת n."
  },
  {
   "id": "o11",
   "s": 36.42,
   "e": 40.2,
   "text": "רושמים בסדר: עמודה ראשונה חצי T וחצי F."
  },
  {
   "id": "o12",
   "s": 40.44,
   "e": 43.2,
   "text": "וכל עמודה אחריה מתחלפת מהר פי שניים."
  },
  {
   "id": "o13",
   "s": 43.62,
   "e": 45.22,
   "text": "אז כשאתם בתור:"
  }
 ],
