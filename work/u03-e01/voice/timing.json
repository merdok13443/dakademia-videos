{
 "lines": [
  {
   "id": "hook",
   "s": 0.0,
   "e": 3.88,
   "text": "״x הוא הסרטון הנצפה ביותר ביוטיוב״: אמת או שקר?"
  },
  {
   "id": "nostamp",
   "s": 4.77,
   "e": 7.4,
   "text": "אי אפשר לענות, עד שמציבים ערך ב-x."
  },
  {
   "id": "despa",
   "s": 7.7,
   "e": 10.04,
   "text": "מציבים דספסיטו: שקר."
  },
  {
   "id": "shark",
   "s": 10.44,
   "e": 12.48,
   "text": "ובייבי שארק: אמת."
  },
  {
   "id": "msg",
   "s": 13.1,
   "e": 17.52,
   "text": "משפט עם משתנה אינו אמת ואינו שקר, עד שמציבים במשתנה ערך."
  },
  {
   "id": "pred",
   "s": 18.72,
   "e": 23.466,
   "text": "משפט כזה נקרא פרדיקט, P(x)."
  },
  {
   "id": "div",
   "s": 21.68,
   "e": 24.3,
   "text": "למשל: ״x מתחלק ב-3״."
  },
  {
   "id": "table",
   "s": 24.96,
   "e": 30.12,
   "text": "6: אמת, 7 ו-8: שקר, 9: אמת."
  },
  {
   "id": "lead",
   "s": 29.12,
   "e": 31.94,
   "text": "ו-P(x) עצמו?"
  },
  {
   "id": "payoff",
   "s": 32.74,
   "e": 35.62,
   "text": "אין לו ערך אמת: הוא עוד לא פסוק."
  },
  {
   "id": "free",
   "s": 35.62,
   "e": 38.16,
   "text": "כי x משתנה חופשי: עוד לא הציבו בו."
  },
  {
   "id": "recap",
   "s": 38.86,
   "e": 41.12,
   "text": "בלי הצבה אין אמת ואין שקר."
  },
  {
   "id": "loop",
   "s": 41.82,
   "e": 42.84,
   "text": "אז מה עונים לשאלה:"
  }
