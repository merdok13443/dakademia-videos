 "lines": [
  {
   "id": "hook",
   "s": 0.0,
   "e": 1.4,
   "text": "לעקרב יש שמונה רגליים."
  },
  {
   "id": "guess",
   "s": 1.74,
   "e": 3.16,
   "text": "אז הוא עכביש?"
  },
  {
   "id": "rule",
   "s": 3.98,
   "e": 6.22,
   "text": "אם זה עכביש, יש לו שמונה רגליים."
  },
  {
   "id": "mp",
   "s": 6.44,
   "e": 9.14,
   "text": "אלמנה שחורה: p אמת, אז q אמת."
  },
  {
   "id": "mt",
   "s": 9.46,
   "e": 11.94,
   "text": "נמלה: q שקר, אז p שקר."
  },
  {
   "id": "msg",
   "s": 12.276,
   "e": 19.7,
   "text": "מ״אם־אז״ מסיקים בבטחה: יש תנאי, יש תוצאה; אין תוצאה, אין תנאי; ואפשר לשרשר."
  },
  {
   "id": "def",
   "s": 20.64,
   "e": 24.26,
   "text": "כלל הסקה: כשההנחות אמת, המסקנה תמיד אמת."
  },
  {
   "id": "chain",
   "s": 25.02,
   "e": 28.74,
   "text": "ושרשור: מתחלק בשמונה, אז בארבע, אז זוגי."
  },
  {
   "id": "lead",
   "s": 29.62,
   "e": 30.1,
   "text": "והעקרב?"
  },
  {
   "id": "payoff",
   "s": 30.42,
   "e": 33.22,
   "text": "שמונה רגליים, ובכל זאת לא עכביש."
  },
  {
   "id": "insight",
   "s": 33.76,
   "e": 36.34,
   "text": "מהתוצאה לבדה לא מסיקים את התנאי."
  },
  {
   "id": "recap",
