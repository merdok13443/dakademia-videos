{
 "lines": [
  {
   "id": "hook",
   "s": 0.0,
   "e": 1.4,
   "text": "לעקרב יש שמונה רגליים."
  },
  {
   "id": "guess",
   "s": 1.74,
   "e": 3.16,
   "text": "אז הוא עכביש?"
  },
  {
   "id": "rule",
   "s": 3.98,
   "e": 6.22,
   "text": "אם זה עכביש, יש לו שמונה רגליים."
  },
  {
   "id": "mp",
   "s": 6.62,
   "e": 9.32,
   "text": "אלמנה שחורה: p אמת, אז q אמת."
  },
  {
   "id": "mt",
   "s": 9.64,
   "e": 12.12,
   "text": "נמלה: q שקר, אז p שקר."
  },
  {
   "id": "msg",
   "s": 12.72,
   "e": 20.144,
   "text": "מ״אם־אז״ מסיקים בבטחה: יש תנאי, יש תוצאה; אין תוצאה, אין תנאי; ואפשר לשרשר."
  },
  {
   "id": "def",
   "s": 21.084,
   "e": 24.704,
   "text": "כלל הסקה: כשההנחות אמת, המסקנה תמיד אמת."
  },
  {
   "id": "chain",
   "s": 25.464,
   "e": 29.184,
   "text": "ושרשור: מתחלק בשמונה, אז בארבע, אז זוגי."
  },
  {
   "id": "lead",
   "s": 30.064,
   "e": 30.544,
   "text": "והעקרב?"
  },
  {
   "id": "payoff",
   "s": 31.344,
   "e": 34.144,
   "text": "שמונה רגליים, ובכל זאת לא עכביש."
  },
  {
   "id": "insight",
   "s": 34.944,
   "e": 37.524,
   "text": "מהתוצאה לבדה לא מסיקים את התנאי."
  },
  {
   "id": "recap",
   "s": 38.124,
   "e": 41.364,
   "text": "יש תנאי, יש תוצאה; אין תוצאה, אין תנאי."
  },
  {
   "id": "loop",
   "s": 41.604,
   "e": 43.204,
   "text": "ולכן כשמישהו שואל:"
  }
 ],
