{
 "lines": [
  {
   "id": "hook",
   "s": 0.0,
   "e": 3.08,
   "text": "לעקרב שמונה רגליים, אז עכביש?"
  },
  {
   "id": "topic",
   "s": 3.78,
   "e": 5.16,
   "text": "שאלה לכללי הסקה."
  },
  {
   "id": "rule",
   "s": 5.48,
   "e": 8.1,
   "text": "אם זה עכביש, יש לו שמונה רגליים."
  },
  {
   "id": "mp",
   "s": 8.48,
   "e": 11.36,
   "text": "אלמנה שחורה: p אמת, אז q אמת."
  },
  {
   "id": "mt",
   "s": 11.86,
   "e": 15.54,
   "text": "נמלה: q שקר, אז p שקר."
  },
  {
   "id": "msg",
   "s": 14.715,
   "e": 22.44,
   "text": "מ״אם־אז״ מסיקים בבטחה: יש תנאי, יש תוצאה; אין תוצאה, אין תנאי."
  },
  {
   "id": "def",
   "s": 23.44,
   "e": 27.4,
   "text": "כלל הסקה: כשההנחות אמת, המסקנה תמיד אמת."
  },
  {
   "id": "chain",
   "s": 28.4,
   "e": 32.3,
   "text": "ושרשור: מתחלק בשמונה, אז בארבע, אז זוגי."
  },
  {
   "id": "lead",
   "s": 33.1,
   "e": 34.3,
   "text": "ומה עם העקרב?"
  },
  {
   "id": "payoff",
   "s": 35.1,
   "e": 38.28,
   "text": "שמונה רגליים, ובכל זאת לא עכביש."
  },
  {
   "id": "insight",
   "s": 39.08,
   "e": 41.78,
   "text": "מהתוצאה לבדה לא מסיקים תנאי."
  },
  {
   "id": "recap",
   "s": 42.08,
   "e": 45.9,
   "text": "יש תנאי, יש תוצאה; אין תוצאה, אין תנאי."
  },
  {
   "id": "loop",
   "s": 46.3,
   "e": 47.82,
   "text": "ולכן כשמישהו שואל:"
  }
 ],
