 "lines": [
  {
   "id": "hook",
   "s": 0.0,
   "e": 2.28,
   "text": "שלושה חברים, מי אוהב את מי?"
  },
  {
   "id": "setup",
   "s": 2.8,
   "e": 6.48,
   "text": "נועה מאוהבת בעומר, עומר בדנה, ודנה בנועה."
  },
  {
   "id": "msg",
   "s": 6.48,
   "e": 11.9,
   "text": "״לכל אחד יש מישהו״ ו״יש מישהו אחד לכולם״ הן טענות שונות: הסדר קובע."
  },
  {
   "id": "each",
   "s": 12.52,
   "e": 14.5,
   "text": "כל אחד אוהב מישהו: אמת."
  },
  {
   "id": "trap",
   "s": 15.34,
   "e": 17.0,
   "text": "ויש מישהו שכולם אוהבים?"
  },
  {
   "id": "payoff",
   "s": 17.44,
   "e": 19.92,
   "text": "שקר: אף אחד לא מקבל מכולם."
  },
  {
   "id": "recap",
   "s": 20.54,
   "e": 22.6,
   "text": "אותן מילים, לא אותה טענה."
  },
  {
   "id": "loop",
   "s": 23.14,
   "e": 25.9,
   "text": "ביחידה הזו תדעו לנסח בדיוק:"
  }
 ],
