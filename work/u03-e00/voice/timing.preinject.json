  {
   "id": "hook",
   "s": 0.0,
   "e": 3.32,
   "text": "כל אחד אוהב מישהו; יש מישהו שכולם אוהבים?"
  },
  {
   "id": "same",
   "s": 3.72,
   "e": 7.92,
   "text": "נשמע אותו דבר: ״לכל״ ו״יש״, בסדר אחר."
  },
  {
   "id": "msg",
   "s": 8.44,
   "e": 14.28,
   "text": "״לכל אחד יש מישהו״ ו״יש מישהו אחד לכולם״ הן טענות שונות: הסדר קובע."
  },
  {
   "id": "check",
   "s": 15.04,
   "e": 18.3,
   "text": "בציור, מכל אחד יוצא לב: הראשונה אמת."
  },
  {
   "id": "trap",
   "s": 18.66,
   "e": 19.76,
   "text": "ומה עם השנייה?"
  },
  {
   "id": "payoff",
   "s": 20.24,
   "e": 22.96,
   "text": "שקר: כל אחד מקבל רק לב אחד."
  },
  {
   "id": "recap",
   "s": 23.7,
   "e": 26.56,
   "text": "לכל אחד מישהו, מול אחד לכולם."
  },
  {
   "id": "loop",
   "s": 27.04,
   "e": 31.16,
   "text": "ביחידה הזו תדעו לנסח, לשלול ולהוכיח טענות כמו:"
