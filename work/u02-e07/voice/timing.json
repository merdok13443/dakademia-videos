{
 "lines": [
  {
   "id": "hook",
   "s": 0.0,
   "e": 2.58,
   "text": "שני שעונים, אותה שעה: שקולים?"
  },
  {
   "id": "twist",
   "s": 3.58,
   "e": 6.64,
   "text": "אחד עומד, וצודק רק פעמיים ביום."
  },
  {
   "id": "msg",
   "s": 7.0,
   "e": 13.0,
   "text": "״אם ורק אם״ נבדק בשורה; שני פסוקים שקולים כשהוא אמת בכל השורות."
  },
  {
   "id": "conn",
   "s": 14.0,
   "e": 16.24,
   "text": "״אם ורק אם״ הוא קשר בתוך פסוק:"
  },
  {
   "id": "row",
   "s": 16.7,
   "e": 19.74,
   "text": "שורה היא רגע: אמת כשהצדדים שווים."
  },
  {
   "id": "conv",
   "s": 20.32,
   "e": 22.42,
   "text": "p גורר q, מול q גורר p:"
  },
  {
   "id": "twice",
   "s": 22.9,
   "e": 24.76,
   "text": "רק פעמיים, כמו השעון."
  },
  {
   "id": "mistake",
   "s": 25.16,
   "e": 27.64,
   "text": "אמת בשורה? עדיין לא שקולים."
  },
  {
   "id": "lead",
   "s": 27.82,
   "e": 30.84,
   "text": "ועם ״לא p, או q״?"
  },
  {
   "id": "payoff",
   "s": 31.84,
   "e": 34.48,
   "text": "״אם ורק אם״ אמת בכל השורות."
  },
  {
   "id": "taut",
   "s": 35.18,
   "e": 37.82,
   "text": "טאוטולוגיה, ומותר לטעון: שקולים."
  },
  {
   "id": "recap",
   "s": 38.82,
   "e": 42.42,
   "text": "״אם ורק אם״: שורה, ״שקולים״: כל השורות."
  },
  {
   "id": "loop",
   "s": 42.82,
   "e": 44.14,
   "text": "וזכרו את השעון העומד:"
  }
 ],
