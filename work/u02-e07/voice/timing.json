{
 "lines": [
  {
   "id": "hook",
   "s": 0.0,
   "e": 3.54,
   "text": "שני שעוני מחוגים מראים אותה שעה, הם שקולים?"
  },
  {
   "id": "twist",
   "s": 4.56,
   "e": 8.2,
   "text": "אחד עומד, וצודק רק פעמיים ביום."
  },
  {
   "id": "msg",
   "s": 9.12,
   "e": 14.8,
   "text": "״אם ורק אם״ נבדק במצב אחד; ״שקולים״ פירושו שהוא אמת בכל המצבים."
  },
  {
   "id": "conn",
   "s": 15.8,
   "e": 18.04,
   "text": "״אם ורק אם״ הוא קשר בתוך פסוק:"
  },
  {
   "id": "row",
   "s": 18.48,
   "e": 20.58,
   "text": "אמת בשורה שבה הצדדים שווים."
  },
  {
   "id": "conv",
   "s": 21.5,
   "e": 23.86,
   "text": "p גורר q, מול q גורר p:"
  },
  {
   "id": "twice",
   "s": 23.86,
   "e": 27.72,
   "text": "שווים רק פעמיים, כמו השעון."
  },
  {
   "id": "lead",
   "s": 28.54,
   "e": 30.34,
   "text": "ועם ״לא p, או q״?"
  },
  {
   "id": "payoff",
   "s": 31.34,
   "e": 34.34,
   "text": "״אם ורק אם״ אמת בכל השורות."
  },
  {
   "id": "taut",
   "s": 34.82,
   "e": 37.96,
   "text": "טאוטולוגיה, ומותר לטעון: שקולים."
  },
  {
   "id": "recap",
   "s": 38.98,
   "e": 43.38,
   "text": "״אם ורק אם״: מצב אחד, ״שקולים״: כל המצבים."
  },
  {
   "id": "loop",
   "s": 43.9,
   "e": 45.3,
   "text": "וזכרו את השעון העומד:"
  }
 ],
