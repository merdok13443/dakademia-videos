{
 "lines": [
  {
   "id": "hook",
   "s": 0.0,
   "e": 3.18,
   "text": "מי שיודעת פייתון או ג׳אווה, יודעת פייתון?"
  },
  {
   "id": "dana",
   "s": 3.92,
   "e": 6.18,
   "text": "אצל דנה, שיודעת שתיהן: אמת."
  },
  {
   "id": "ask",
   "s": 6.66,
   "e": 8.04,
   "text": "זו גרירה לוגית?"
  },
  {
   "id": "java",
   "s": 8.74,
   "e": 11.74,
   "text": "לא. מי שיודעת רק ג׳אווה: שקר."
  },
  {
   "id": "msg",
   "s": 12.34,
   "e": 17.9,
   "text": "טענה גוררת אחרת כשאין אף מצב שבו הראשונה אמת והשנייה שקר."
  },
  {
   "id": "rows",
   "s": 18.9,
   "e": 20.5,
   "text": "כל שורה בלוח היא מצב."
  },
  {
   "id": "arrow",
   "s": 21.0,
   "e": 25.98,
   "text": "החץ נותן ערך בכל שורה: אמת, אמת, שקר, אמת."
  },
  {
   "id": "onef",
   "s": 26.46,
   "e": 28.04,
   "text": "שקר אחד, ואין גרירה."
  },
  {
   "id": "other",
   "s": 28.7,
   "e": 32.3,
   "text": "ובכיוון השני: אמת, אמת, אמת, אמת."
  },
  {
   "id": "payoff",
   "s": 32.76,
   "e": 35.72,
   "text": "גרירה: החץ אמת בכל השורות."
  },
  {
   "id": "anchor",
   "s": 36.72,
   "e": 38.14,
   "text": "p גורר p או q."
  },
  {
   "id": "recap",
   "s": 38.46,
   "e": 41.6,
   "text": "בכל מצב שבו הראשונה אמת, גם השנייה."
  },
  {
   "id": "loop",
   "s": 42.3,
   "e": 43.32,
   "text": "תבדקו כל שורה:"
  }
 ],
