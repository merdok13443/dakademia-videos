{
 "lines": [
  {
   "id": "hook",
   "s": 0.0,
   "e": 3.26,
   "text": "מי שיודעת פייתון או ג׳אווה, יודעת פייתון?"
  },
  {
   "id": "dana",
   "s": 3.76,
   "e": 6.2,
   "text": "אצל דנה, שיודעת שתיהן: אמת."
  },
  {
   "id": "ask",
   "s": 6.7,
   "e": 8.12,
   "text": "זו גרירה לוגית?"
  },
  {
   "id": "java",
   "s": 8.84,
   "e": 11.46,
   "text": "מי שיודעת רק ג׳אווה: שקר."
  },
  {
   "id": "msg",
   "s": 11.98,
   "e": 17.76,
   "text": "טענה גוררת אחרת כשאין אף מצב שבו הראשונה אמת והשנייה שקר."
  },
  {
   "id": "rows",
   "s": 18.76,
   "e": 20.2,
   "text": "כל שורה בלוח היא מצב."
  },
  {
   "id": "arrow",
   "s": 20.84,
   "e": 26.34,
   "text": "p או q גורר p? החץ: אמת, אמת, שקר, אמת."
  },
  {
   "id": "onef",
   "s": 26.9,
   "e": 28.52,
   "text": "שקר אחד, ואין גרירה."
  },
  {
   "id": "other",
   "s": 29.42,
   "e": 32.92,
   "text": "ולהפך, p גורר p או q? תמיד אמת."
  },
  {
   "id": "payoff",
   "s": 33.46,
   "e": 36.36,
   "text": "גרירה: החץ אמת בכל השורות."
  },
  {
   "id": "anchor",
   "s": 37.36,
   "e": 38.9,
   "text": "p גורר p או q."
  },
  {
   "id": "recap",
   "s": 39.66,
   "e": 42.26,
   "text": "בכל מצב שבו הראשונה אמת, גם השנייה."
  },
  {
   "id": "loop",
   "s": 42.96,
   "e": 43.98,
   "text": "תבדקו כל שורה:"
  }
 ],
