   "id": "hook",
   "s": 0.0,
   "e": 3.26,
   "text": "מי שיודעת פייתון או ג׳אווה, יודעת פייתון?"
  },
  {
   "id": "dana",
   "s": 3.42,
   "e": 5.86,
   "text": "אצל דנה, שיודעת שתיהן: אמת."
  },
  {
   "id": "ask",
   "s": 6.36,
   "e": 7.78,
   "text": "זו גרירה לוגית?"
  },
  {
   "id": "java",
   "s": 8.5,
   "e": 11.12,
   "text": "מי שיודעת רק ג׳אווה: שקר."
