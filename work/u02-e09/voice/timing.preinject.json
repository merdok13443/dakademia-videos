  {
   "id": "hook",
   "s": 0.0,
   "e": 3.18,
   "text": "מי שיודעת פייתון או ג׳אווה, יודעת פייתון?"
  },
  {
   "id": "dana",
   "s": 3.92,
   "e": 6.18,
   "text": "אצל דנה, שיודעת שתיהן: אמת."
  },
  {
   "id": "ask",
   "s": 6.66,
   "e": 8.04,
   "text": "זו גרירה לוגית?"
  },
  {
   "id": "java",
   "s": 8.58,
   "e": 11.58,
   "text": "לא. מי שיודעת רק ג׳אווה: שקר."
  },
  {
   "id": "msg",
   "s": 11.96,
   "e": 17.52,
   "text": "טענה גוררת אחרת כשאין אף מצב שבו הראשונה אמת והשנייה שקר."
  },
  {
   "id": "rows",
   "s": 18.02,
   "e": 19.62,
   "text": "כל שורה בלוח היא מצב."
  },
  {
   "id": "arrow",
   "s": 20.12,
   "e": 25.1,
   "text": "החץ נותן ערך בכל שורה: אמת, אמת, שקר, אמת."
  },
  {
   "id": "onef",
   "s": 25.58,
   "e": 27.16,
   "text": "שקר אחד, ואין גרירה."
  },
  {
   "id": "other",
   "s": 27.82,
   "e": 31.42,
   "text": "ובכיוון השני: אמת, אמת, אמת, אמת."
  },
  {
   "id": "payoff",
   "s": 31.88,
   "e": 34.6,
   "text": "גרירה: החץ אמת בכל השורות."
  },
  {
