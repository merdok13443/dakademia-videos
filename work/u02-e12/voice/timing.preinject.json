{
 "lines": [
  {
   "id": "hook",
   "s": 0.0,
   "e": 2.68,
   "text": "הגלאי התריע. סימן שבינה מלאכותית כתבה?"
  },
  {
   "id": "premise",
   "s": 3.22,
   "e": 6.56,
   "text": "נניח: אם בינה מלאכותית כתבה, הגלאי מתריע."
  },
  {
   "id": "argument",
   "s": 6.96,
   "e": 9.32,
   "text": "זה טיעון: הנחות ומסקנה."
  },
  {
   "id": "msg",
   "s": 9.9,
   "e": 16.22,
   "text": "בודקים טיעון בלוח אמת: שורה אחת שבה ההנחות אמת והמסקנה שקר מפילה אותו."
  },
  {
   "id": "vars",
   "s": 17.14,
   "e": 20.22,
   "text": "p: בינה מלאכותית כתבה. q: הגלאי התריע."
  },
  {
   "id": "form",
   "s": 20.66,
   "e": 25.06,
   "text": "הנחות: אם p אז q, ו-q. מסקנה: p."
  },
  {
   "id": "search",
   "s": 25.78,
   "e": 28.3,
   "text": "בארבע שורות, איפה ההנחות אמת?"
  },
  {
   "id": "row3",
   "s": 29.54,
   "e": 31.92,
   "text": "ובשלישית, המסקנה שקר."
  },
  {
   "id": "payoff",
   "s": 32.44,
   "e": 35.48,
   "text": "נשמע משכנע, ובכל זאת נופל."
  },
  {
   "id": "anchor",
   "s": 36.06,
   "e": 37.94,
   "text": "אדם כתב, והגלאי התריע."
  },
  {
   "id": "fact",
   "s": 38.32,
   "e": 40.02,
   "text": "קרה באמת לגלאי של OpenAI."
  },
  {
   "id": "recap",
   "s": 41.05,
   "e": 43.7,
   "text": "טיעון תקף רק כשאין שורה מפילה."
  },
  {
   "id": "loop",
   "s": 44.14,
   "e": 45.64,
   "text": "בפעם הבאה שמישהו אומר:"
  }
