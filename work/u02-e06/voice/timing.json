{
 "lines": [
  {
   "id": "hook",
   "s": 0.0,
   "e": 2.92,
   "text": "אין קליטה, אז הטלפון במצב טיסה?"
  },
  {
   "id": "rule",
   "s": 3.9,
   "e": 6.5,
   "text": "אם הטלפון במצב טיסה, אין קליטה."
  },
  {
   "id": "lift",
   "s": 7.0,
   "e": 11.58,
   "text": "אבל במעלית אין קליטה, גם בלי מצב טיסה."
  },
  {
   "id": "msg",
   "s": 13.06,
   "e": 19.7,
   "text": "טענת אם-אז נשארת אותה טענה רק כשהופכים את הכיוון וגם שוללים את הצדדים."
  },
  {
   "id": "conv",
   "s": 20.7,
   "e": 23.0,
   "text": "רק הופכים את הכיוון: ההפוכה."
  },
  {
   "id": "inv",
   "s": 23.6,
   "e": 26.224,
   "text": "רק שוללים את הצדדים: ההפוכה-השלילית."
  },
  {
   "id": "contra",
   "s": 27.46,
   "e": 31.02,
   "text": "הופכים וגם שוללים: קונטרה-פוזיטיב."
  },
  {
   "id": "table",
   "s": 31.94,
   "e": 35.1,
   "text": "בלוח האמת, רק הקונטרה-פוזיטיב זהה למקורית."
  },
  {
   "id": "lead",
   "s": 36.02,
   "e": 37.1,
   "text": "ובשורה של המעלית..."
  },
  {
   "id": "payoff",
   "s": 38.18,
   "e": 42.0,
   "text": "ההפוכה וההפוכה-השלילית נשברות, והמקורית עומדת."
  },
  {
   "id": "why",
   "s": 42.8,
   "e": 45.34,
   "text": "הכלל שותק על טלפון בלי מצב טיסה."
  },
  {
   "id": "recap",
   "s": 46.5,
   "e": 49.1,
   "text": "הופכים וגם שוללים: אותה טענה."
  },
  {
   "id": "loop",
   "s": 50.06,
   "e": 52.1,
   "text": "במעלית, תשאלו את עצמכם:"
  }
 ],
