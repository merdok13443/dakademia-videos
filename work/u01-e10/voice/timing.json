{
 "lines": [
  {
   "id": "h1",
   "s": 0.0,
   "e": 3.64,
   "text": "אין להכניס אוכל ושתייה. ופיצה בלבד?"
  },
  {
   "id": "s2",
   "s": 4.99,
   "e": 8.18,
   "text": "מכניסים אוכל: p, מכניסים שתייה: q."
  },
  {
   "id": "s3",
   "s": 8.6,
   "e": 12.44,
   "text": "מילה במילה: לא שניהם, p וגם q."
  },
  {
   "id": "s4",
   "s": 13.04,
   "e": 17.78,
   "text": "ואז פיצה בלבד יוצא אמת: מותר."
  },
  {
   "id": "m5",
   "s": 19.27,
   "e": 25.06,
   "text": "הצרנה: כל טענה פשוטה הופכת לאות, וכל מילת חיבור לקשר, לפי המשמעות."
  },
  {
   "id": "d6",
   "s": 26.06,
   "e": 28.55,
   "text": "טענה פשוטה: בלי מילת חיבור."
  },
  {
   "id": "a7",
   "s": 29.31,
   "e": 30.59,
   "text": "ומה השלט אוסר?"
  },
  {
   "id": "b8",
   "s": 31.29,
   "e": 33.73,
   "text": "לא אוכל, וגם לא שתייה."
  },
  {
   "id": "l9",
   "s": 34.43,
   "e": 35.63,
   "text": "ושוב, פיצה בלבד?"
  },
  {
   "id": "p10",
   "s": 36.81,
   "e": 40.61,
   "text": "הפסוק יוצא שקר: אסור, כמו בשלט."
  },
  {
   "id": "x11",
   "s": 41.77,
   "e": 45.33,
   "text": "ובמספרים: 7 אינו זוגי ואינו שלילי."
  },
  {
   "id": "r12",
   "s": 46.77,
   "e": 50.57,
   "text": "אות לכל טענה, קשר לכל חיבור, לפי המשמעות."
  },
  {
   "id": "o13",
   "s": 51.21,
   "e": 52.65,
   "text": "אז כשכתוב על הדלת:"
  }
 ],
