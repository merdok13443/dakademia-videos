{
 "lines": [
  {
   "id": "h1",
   "s": 0.0,
   "e": 3.58,
   "text": "אין להכניס אוכל או שתייה, ופיצה בלבד?"
  },
  {
   "id": "s2",
   "s": 4.79,
   "e": 7.36,
   "text": "הצרנה: אוכל זה p, שתייה q."
  },
  {
   "id": "s3",
   "s": 7.86,
   "e": 10.5,
   "text": "מילה במילה: לא p, או לא q."
  },
  {
   "id": "s4",
   "s": 10.94,
   "e": 13.88,
   "text": "אז פיצה בלבד: אמת, מותר."
  },
  {
   "id": "m5",
   "s": 15.09,
   "e": 21.24,
   "text": "הצרנה: כל טענה פשוטה הופכת לאות, וכל מילת חיבור לקשר, לפי המשמעות."
  },
  {
   "id": "d6",
   "s": 22.24,
   "e": 24.21,
   "text": "טענה פשוטה: בלי מילת חיבור."
  },
  {
   "id": "b7",
   "s": 24.73,
   "e": 28.89,
   "text": "השלט אוסר: לא אוכל, וגם לא שתייה."
  },
  {
   "id": "t8",
   "s": 29.41,
   "e": 33.11,
   "text": "ידיים ריקות: אמת, ועם שתייה: שקר."
  },
  {
   "id": "l9",
   "s": 34.31,
   "e": 36.23,
   "text": "ושוב, פיצה בלבד?"
  },
  {
   "id": "p10",
   "s": 37.61,
   "e": 40.97,
   "text": "שקר: אסור. מילה במילה טעתה."
  },
  {
   "id": "x11",
   "s": 42.07,
   "e": 45.17,
   "text": "ובמספרים: 7 אינו זוגי או שלילי."
  },
  {
   "id": "r12",
   "s": 45.65,
   "e": 48.39,
   "text": "אות לכל טענה, קשר לפי המשמעות."
  },
  {
   "id": "o13",
   "s": 48.97,
   "e": 50.25,
   "text": "וכשכתוב על הדלת:"
  }
 ],
