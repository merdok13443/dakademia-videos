   "id": "hook",
   "s": 0.0,
   "e": 4.22,
   "text": "אמת או שקר: לא נכון שאיינשטיין גם נכשל במתמטיקה וגם זכה בנובל?"
  },
  {
   "id": "true",
   "s": 4.86,
   "e": 6.88,
   "text": "אמת, הוא מעולם לא נכשל."
  },
  {
   "id": "mask",
   "s": 7.12,
   "e": 10.32,
   "text": "במסווה: לא נכשל או לא זכה, ושוב אמת."
  },
  {
   "id": "msg",
   "s": 10.7,
   "e": 15.44,
   "text": "שני משפטים שקולים כשהם אמת ושקר בדיוק באותם מצבים, אפילו בניסוח אחר."
  },
  {
   "id": "table",
   "s": 15.9,
   "e": 17.46,
   "text": "בודקים כל מצב."
  },
  {
   "id": "trap",
   "s": 17.74,
   "e": 20.06,
   "text": "ומה עם לא נכשל ולא זכה?"
  },
  {
   "id": "payoff",
   "s": 20.36,
   "e": 22.82,
   "text": "שקר: בנובל הוא זכה, אז לא שקול."
  },
  {
   "id": "recap",
   "s": 23.16,
   "e": 26.04,
   "text": "שקולים: אותו ערך אמת בכל מצב."
  },
  {
   "id": "loop",
   "s": 26.38,
   "e": 28.56,
   "text": "ביחידה הזו תדעו לענות בלי לנחש:"
  }
