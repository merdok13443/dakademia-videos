{
 "lines": [
  {
   "id": "hook",
   "s": 0.0,
   "e": 1.12,
   "text": "כמה יוצא הביטוי הזה?"
  },
  {
   "id": "split",
   "s": 1.46,
   "e": 4.5,
   "text": "הרשת התפצלה: אחת, מול שש-עשרה."
  },
  {
   "id": "both",
   "s": 5.1,
   "e": 7.58,
   "text": "כל צד חישב נכון לפי סדר אחר."
  },
  {
   "id": "msg",
   "s": 8.36,
   "e": 11.4,
   "text": "סדר קדימויות מוסכם קובע איך קוראים פסוק."
  },
  {
   "id": "msg2",
   "s": 11.68,
   "e": 13.5,
   "text": "וכשיש ספק, שמים סוגריים."
  },
  {
   "id": "def",
   "s": 14.06,
   "e": 16.22,
   "text": "קשר חזק מתחבר ראשון."
  },
  {
   "id": "order",
   "s": 16.7,
   "e": 22.06,
   "text": "מהחזק לחלש: לא, וגם, או, אם-אז, אם ורק אם."
  },
  {
   "id": "and1st",
   "s": 22.88,
   "e": 25.76,
   "text": "p או q וגם r: וגם קודם."
  },
  {
   "id": "ask",
   "s": 26.2,
   "e": 29.52,
   "text": "ומה יוצא כשמציבים: p אמת, q ו-r שקר?"
  },
  {
   "id": "payoff",
   "s": 30.0,
   "e": 33.98,
   "text": "לפי הסדר המוסכם אמת, משמאל לימין שקר."
  },
  {
   "id": "recap",
   "s": 34.78,
   "e": 38.58,
   "text": "אז: סדר מוסכם קובע איך קוראים, ובספק, שמים סוגריים."
  },
  {
   "id": "loop",
   "s": 38.94,
   "e": 41.62,
   "text": "ולכן בודקים סדר וסוגריים לפני ששואלים:"
  }
