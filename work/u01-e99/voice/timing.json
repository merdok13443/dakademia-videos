{
 "lines": [
  {
   "id": "o1",
   "s": 0.0,
   "e": 2.18,
   "text": "הלוגיקה הפסוקית, על דף אחד."
  },
  {
   "id": "k2",
   "s": 2.98,
   "e": 6.72,
   "text": "שלילה, וגם, או, אם-אז, ואם ורק אם."
  },
  {
   "id": "t3",
   "s": 7.52,
   "e": 8.8,
   "text": "ולוח אמת אחד לכולם."
  },
  {
   "id": "a5",
   "s": 9.8,
   "e": 12.34,
   "text": "וגם: אמת רק כששניהם אמת."
  },
  {
   "id": "a6",
   "s": 12.78,
   "e": 15.0,
   "text": "או: שקר רק כששניהם שקר."
  },
  {
   "id": "a7",
   "s": 14.97,
   "e": 19.76,
   "text": "אם-אז: שקר רק כשהתנאי אמת והתוצאה שקר."
  },
  {
   "id": "a8",
   "s": 20.28,
   "e": 22.88,
   "text": "ואם ורק אם: אמת כשהערכים שווים."
  },
  {
   "id": "u9",
   "s": 23.94,
   "e": 26.52,
   "text": "n משתנים: שתיים בחזקת n שורות."
  },
  {
   "id": "u10",
   "s": 26.9,
   "e": 30.22,
   "text": "תמיד אמת: טאוטולוגיה. תמיד שקר: סתירה."
  },
  {
   "id": "u11",
   "s": 30.72,
   "e": 33.42,
   "text": "סדר קדימויות, ובספק: סוגריים."
  },
  {
   "id": "m12",
   "s": 34.3,
   "e": 39.6,
   "text": "כל קשר לוגי מוגדר בלוח אמת: האמת של השלם נקבעת רק מהחלקים."
  },
  {
   "id": "d13",
   "s": 40.8,
   "e": 42.08,
   "text": "דף הסיכום בתיאור."
  },
  {
   "id": "l14",
   "s": 42.86,
   "e": 44.8,
   "text": "וכששוכחים קשר, חוזרים אל"
  }
 ],
