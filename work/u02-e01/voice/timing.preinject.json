{
 "lines": [
  {
   "id": "hook",
   "s": 0.0,
   "e": 1.98,
   "text": "שני השלטים האלה שקולים?"
  },
  {
   "id": "guess",
   "s": 2.68,
   "e": 5.18,
   "text": "נשמע כמו שני כללים, אבל הם שקולים."
  },
  {
   "id": "msg",
   "s": 5.44,
   "e": 10.62,
   "text": "שני פסוקים שקולים כשיש להם אותו לוח אמת: אותו ערך בכל מצב."
  },
  {
   "id": "vars",
   "s": 11.3,
   "e": 14.42,
   "text": "p שתה, q נהג: ארבעה מצבים."
  },
  {
   "id": "bridge",
   "s": 14.82,
   "e": 16.5,
   "text": "כלל שנשבר מקבל F."
  },
  {
   "id": "col1",
   "s": 17.24,
   "e": 19.66,
   "text": "הראשון נשבר רק כששתה ונהג."
  },
  {
   "id": "col2",
   "s": 20.06,
   "e": 22.36,
   "text": "גם השני נשבר רק שם: אותה עמודה."
  },
  {
   "id": "lead",
   "s": 23.08,
   "e": 26.28,
   "text": "ו״לא שותים ולא נוהגים״ נשמע דומה, נכון?"
  },
  {
   "id": "home",
   "s": 26.84,
   "e": 30.1,
   "text": "מי ששתה בבית שובר אותו, ולכן לא שקול."
  },
  {
   "id": "one",
   "s": 30.48,
   "e": 32.02,
   "text": "מספיקה שורה אחת שונה."
  },
  {
   "id": "recap",
   "s": 32.9,
   "e": 36.08,
   "text": "הניסוח מטעה, שקולים: אותו ערך בכל שורה."
  },
  {
   "id": "loop",
   "s": 36.6,
   "e": 38.66,
   "text": "ובפעם הבאה, תשאל את עצמך:"
  }
 ],
