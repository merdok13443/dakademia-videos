{
 "lines": [
  {
   "id": "hook",
   "s": 0.0,
   "e": 3.94,
   "text": "״אם שותים, לא נוהגים״. ״אם נוהגים, לא שותים״. כמה כללים?"
  },
  {
   "id": "guess",
   "s": 4.84,
   "e": 7.58,
   "text": "נשמע כמו שניים. הם שקולים."
  },
  {
   "id": "msg",
   "s": 8.22,
   "e": 12.8,
   "text": "שני פסוקים שקולים כשיש להם אותו לוח אמת: אותו ערך בכל מצב."
  },
  {
   "id": "vars",
   "s": 14.0,
   "e": 17.34,
   "text": "p: שתה. q: נהג. ארבעה מצבים."
  },
  {
   "id": "bridge",
   "s": 17.74,
   "e": 19.22,
   "text": "כלל שנשבר מקבל F."
  },
  {
   "id": "col1",
   "s": 19.92,
   "e": 22.6,
   "text": "הראשון נשבר רק כששתה ונהג."
  },
  {
   "id": "col2",
   "s": 23.0,
   "e": 26.16,
   "text": "והשני? גם רק שם: אותה עמודה."
  },
  {
   "id": "lead",
   "s": 27.06,
   "e": 30.04,
   "text": "ו״לא שותים ולא נוהגים״? נשמע דומה..."
  },
  {
   "id": "home",
   "s": 31.08,
   "e": 34.04,
   "text": "מי ששתה בבית שובר אותו. לא שקול."
  },
  {
   "id": "one",
   "s": 35.04,
   "e": 36.52,
   "text": "מספיקה שורה אחת שונה."
  },
  {
   "id": "recap",
   "s": 37.38,
   "e": 40.8,
   "text": "הניסוח מטעה. שקולים: אותו ערך בכל שורה."
  },
  {
   "id": "loop",
   "s": 41.36,
   "e": 43.18,
   "text": "ובפעם הבאה שאומרים לך:"
  }
 ],
