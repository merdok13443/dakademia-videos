{
 "lines": [
  {
   "id": "hook",
   "s": 0.0,
   "e": 3.18,
   "text": "״אם אבחר, המיסים ירדו״. מתי ההבטחה נשברת?"
  },
  {
   "id": "broke",
   "s": 3.5,
   "e": 5.76,
   "text": "נבחר, והמיסים עלו? הפר."
  },
  {
   "id": "riddle",
   "s": 6.1,
   "e": 7.96,
   "text": "והוא לא נבחר, והמיסים עלו?"
  },
  {
   "id": "twist",
   "s": 8.28,
   "e": 11.0,
   "text": "לא הפר. ההבטחה בכלל לא נבדקה."
  },
  {
   "id": "msg",
   "s": 11.36,
   "e": 16.42,
   "text": "טענת ״אם-אז״ נשברת רק כשהתנאי קרה, והתוצאה לא קרתה."
  },
  {
   "id": "notation",
   "s": 16.8,
   "e": 20.02,
   "text": "אם p, אז q: p התנאי, q התוצאה."
  },
  {
   "id": "bridge",
   "s": 20.2,
   "e": 22.38,
   "text": "אם x זוגי, אז x גדול משלוש."
  },
  {
   "id": "six-two",
   "s": 22.92,
   "e": 25.22,
   "text": "שש? אמת. שתיים? שקר."
  },
  {
   "id": "lead",
   "s": 25.497,
   "e": 27.04,
   "text": "וחמש? ואחת?"
  },
  {
   "id": "payoff",
   "s": 27.44,
   "e": 29.92,
   "text": "התנאי לא קרה, ולכן הטענה אמת."
  },
  {
   "id": "def",
   "s": 30.6,
   "e": 33.76,
   "text": "רק שורה אחת בלוח שקר: p אמת, q שקר."
  },
  {
   "id": "recap",
   "s": 33.36,
   "e": 37.34,
   "text": "אם-אז נשבר רק כשהתנאי קרה, והתוצאה לא."
  },
  {
   "id": "loop",
   "s": 37.82,
   "e": 38.8,
   "text": "וכשמבטיחים לכם:"
  }
 ],
