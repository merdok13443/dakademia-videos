{
 "lines": [
  {
   "id": "hook",
   "s": 0.0,
   "e": 3.18,
   "text": "״אם אבחר, המיסים ירדו״. מתי ההבטחה נשברת?"
  },
  {
   "id": "broke",
   "s": 3.78,
   "e": 5.96,
   "text": "נבחר, והמיסים עלו? הפר."
  },
  {
   "id": "riddle",
   "s": 6.46,
   "e": 8.88,
   "text": "והוא לא נבחר, והמיסים עלו?"
  },
  {
   "id": "twist",
   "s": 9.88,
   "e": 12.24,
   "text": "לא הפר. ההבטחה בכלל לא נבדקה."
  },
  {
   "id": "msg",
   "s": 12.94,
   "e": 18.38,
   "text": "טענת ״אם-אז״ נשברת רק כשהתנאי קרה, והתוצאה לא קרתה."
  },
  {
   "id": "notation",
   "s": 19.27,
   "e": 22.2,
   "text": "אם p, אז q: p התנאי, q התוצאה."
  },
  {
   "id": "bridge",
   "s": 23.0,
   "e": 25.63,
   "text": "אם x זוגי, אז x גדול משלוש."
  },
  {
   "id": "six",
   "s": 26.13,
   "e": 27.53,
   "text": "שש? אמת."
  },
  {
   "id": "lead",
   "s": 28.173,
   "e": 31.37,
   "text": "ושתיים? זוגי, ולא גדול משלוש."
  },
  {
   "id": "payoff",
   "s": 32.17,
   "e": 35.99,
   "text": "רק שורה אחת בלוח שקר: p אמת, q שקר."
  },
  {
   "id": "anchor",
   "s": 36.99,
   "e": 38.49,
   "text": "זו בדיוק ההבטחה שהופרה."
  },
  {
   "id": "recap",
   "s": 39.341,
   "e": 42.99,
   "text": "אם-אז נשבר רק כשהתנאי קרה, והתוצאה לא."
  },
  {
   "id": "loop",
   "s": 44.21,
   "e": 45.43,
   "text": "וכשמבטיחים לכם:"
  }
 ],
