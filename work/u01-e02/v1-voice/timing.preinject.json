{
 "lines": [
  {
   "id": "hook",
   "s": 0.0,
   "e": 2.54,
   "text": "המשחק נגמר אחד אחד. מכבי ניצחה?"
  },
  {
   "id": "f1",
   "s": 2.8,
   "e": 5.94,
   "text": "שקר. אז מכבי הפסידה? גם שקר."
  },
  {
   "id": "odd",
   "s": 6.24,
   "e": 8.36,
   "text": "שני שקרים. אז מה האמת?"
  },
  {
   "id": "msg",
   "s": 8.86,
   "e": 13.26,
   "text": "השלילה של p היא ״לא נכון ש-p״, לא ההפך של p."
  },
  {
   "id": "t",
   "s": 13.52,
   "e": 15.48,
   "text": "מכבי לא ניצחה. אמת."
  },
  {
   "id": "def",
   "s": 16.1,
   "e": 18.62,
   "text": "שלילה תמיד הפוכה באמת מהפסוק עצמו."
  },
  {
   "id": "g1",
   "s": 19.1,
   "e": 22.3,
   "text": "ובמספרים: אחד גדול מאחד? שקר."
  },
  {
   "id": "g2",
   "s": 22.64,
   "e": 25.06,
   "text": "אחד קטן מאחד? גם שקר."
  },
  {
   "id": "same",
   "s": 25.34,
   "e": 26.96,
   "text": "שני שקרים, כמו במשחק."
  },
  {
   "id": "lead",
   "s": 27.28,
   "e": 28.9,
   "text": "ושלילת ״גדול מאחד״?"
  },
  {
   "id": "pay",
   "s": 29.1,
   "e": 32.0,
   "text": "אמת. ״לא גדול״ זה לא ״קטן״."
  },
  {
   "id": "back",
   "s": 32.22,
   "e": 35.48,
   "text": "כך גם במשחק: לא ניצחה, לא אומר הפסידה."
  },
  {
   "id": "recap",
   "s": 35.86,
   "e": 38.68,
   "text": "שלילה: לא נכון ש-p. לא ההפך."
  },
  {
   "id": "loop",
