{
 "lines": [
  {
   "id": "hook",
   "s": 0.0,
   "e": 2.72,
   "text": "המשחק נגמר אחד אחד. מכבי ניצחה?"
  },
  {
   "id": "f1",
   "s": 3.42,
   "e": 6.5,
   "text": "שקר. אז מכבי הפסידה? גם שקר."
  },
  {
   "id": "odd",
   "s": 7.0,
   "e": 9.0,
   "text": "שני שקרים. אז מה האמת?"
  },
  {
   "id": "msg",
   "s": 9.8,
   "e": 14.4,
   "text": "השלילה של p היא ״p איננו נכון״, ולא הטענה ההפוכה."
  },
  {
   "id": "t",
   "s": 15.7,
   "e": 17.5,
   "text": "מכבי לא ניצחה. אמת."
  },
  {
   "id": "def",
   "s": 18.2,
   "e": 21.1,
   "text": "שלילה תמיד הפוכה באמת מהפסוק עצמו."
  },
  {
   "id": "g1",
   "s": 21.9,
   "e": 23.8,
   "text": "אחד גדול מאחד? שקר."
  },
  {
   "id": "g2",
   "s": 24.1,
   "e": 26.58,
   "text": "אחד קטן מאחד? גם שקר."
  },
  {
   "id": "same",
   "s": 27.38,
   "e": 29.1,
   "text": "שני שקרים, כמו במשחק."
  },
  {
   "id": "lead",
   "s": 29.8,
   "e": 31.44,
   "text": "ושלילת ״גדול מאחד״?"
  },
  {
   "id": "pay",
   "s": 32.24,
   "e": 35.56,
   "text": "אמת. ״איננו גדול״ עדיין לא אומר ״קטן״."
  },
  {
   "id": "back",
   "s": 35.98,
   "e": 39.46,
   "text": "במשחק: מי שלא ניצחה, לא בהכרח הפסידה."
  },
  {
   "id": "recap",
   "s": 40.46,
   "e": 44.1,
   "text": "שלילה: p איננו נכון, ולא הטענה ההפוכה."
  },
  {
   "id": "loop",
   "s": 44.44,
   "e": 45.99,
   "text": "אז תגידו לי:"
  }
 ],
