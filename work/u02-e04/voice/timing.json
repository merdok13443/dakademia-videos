{
 "lines": [
  {
   "id": "hook",
   "s": 0.0,
   "e": 3.78,
   "text": "שלילה כפולה: ״לא נכון שאני לא מסכים לקבל פרסומות״?"
  },
  {
   "id": "guess",
   "s": 4.08,
   "e": 6.18,
   "text": "סימנתם, אז סירבתם, נכון?"
  },
  {
   "id": "twist",
   "s": 6.98,
   "e": 9.6,
   "text": "טעות, בעצם הסכמתם."
  },
  {
   "id": "msg",
   "s": 10.1,
   "e": 17.26,
   "text": "שלילה כפולה מתבטלת; ״וגם אמת״ ו״או שקר״ משאירים את הפסוק כמו שהוא."
  },
  {
   "id": "neg",
   "s": 18.16,
   "e": 20.32,
   "text": "כל ״לא״ הופך את ערך האמת."
  },
  {
   "id": "nnp",
   "s": 21.996,
   "e": 23.48,
   "text": "¬¬p מתהפך פעמיים: שוב p."
  },
  {
   "id": "const",
   "s": 24.04,
   "e": 26.5,
   "text": "T תמיד אמת, F תמיד שקר."
  },
  {
   "id": "and_t",
   "s": 26.96,
   "e": 28.88,
   "text": "p וגם אמת: p."
  },
  {
   "id": "or_f",
   "s": 29.38,
   "e": 31.26,
   "text": "p או שקר: p."
  },
  {
   "id": "and_f",
   "s": 31.76,
   "e": 33.98,
   "text": "p וגם שקר: תמיד שקר."
  },
  {
   "id": "lead",
   "s": 34.58,
   "e": 35.84,
   "text": "ומה בתיבה שלנו..."
  },
  {
   "id": "payoff",
   "s": 36.64,
   "e": 39.6,
   "text": "שתי השלילות נמחקו, ונשארה הסכמה."
  },
  {
   "id": "recap",
   "s": 40.4,
   "e": 45.32,
   "text": "שלילה כפולה מתבטלת, ואמת ב״וגם״ ושקר ב״או״ נעלמים."
  },
  {
   "id": "loop",
   "s": 46.12,
   "e": 47.34,
   "text": "אז רגע, מה עושה"
  }
 ],
