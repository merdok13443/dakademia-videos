{
 "lines": [
  {
   "id": "hook",
   "s": 0.0,
   "e": 4.14,
   "text": "סימנתם ״לא נכון שאני לא מסכים לקבל פרסומות״?"
  },
  {
   "id": "guess",
   "s": 4.76,
   "e": 6.14,
   "text": "אז סירבתם, נכון?"
  },
  {
   "id": "twist",
   "s": 6.98,
   "e": 9.02,
   "text": "טעות. הסכמתם."
  },
  {
   "id": "msg",
   "s": 9.5,
   "e": 15.24,
   "text": "שלילה כפולה מתבטלת; ״וגם אמת״ ו״או שקר״ משאירים את הפסוק כמו שהוא."
  },
  {
   "id": "neg",
   "s": 16.14,
   "e": 18.5,
   "text": "כל ״לא״ הופך את ערך האמת."
  },
  {
   "id": "nnp",
   "s": 19.02,
   "e": 22.44,
   "text": "אז ¬¬p מתהפך פעמיים: שוב p."
  },
  {
   "id": "const",
   "s": 23.06,
   "e": 25.48,
   "text": "T תמיד אמת, F תמיד שקר."
  },
  {
   "id": "and_t",
   "s": 25.96,
   "e": 27.8,
   "text": "p וגם אמת: p."
  },
  {
   "id": "or_f",
   "s": 28.34,
   "e": 30.36,
   "text": "p או שקר: p."
  },
  {
   "id": "and_f",
   "s": 30.84,
   "e": 33.74,
   "text": "p וגם שקר? תמיד שקר."
  },
  {
   "id": "lead",
   "s": 34.24,
   "e": 35.54,
   "text": "ובתיבה שלנו..."
  },
  {
   "id": "payoff",
   "s": 36.24,
   "e": 39.32,
   "text": "שתי השלילות נמחקו, ונשארה הסכמה."
  },
  {
   "id": "recap",
   "s": 40.04,
   "e": 44.44,
   "text": "שלילה כפולה מתבטלת, ואמת ב״וגם״ ושקר ב״או״ נעלמים."
  },
  {
   "id": "loop",
   "s": 45.1,
   "e": 46.68,
   "text": "אז רגע, מה קורה אם"
  }
