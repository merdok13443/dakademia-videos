 "lines": [
  {
   "id": "hook",
   "s": 0.0,
   "e": 3.78,
   "text": "שלילה כפולה: ״לא נכון שאני לא מסכים לקבל פרסומות״?"
  },
  {
   "id": "guess",
   "s": 4.08,
   "e": 6.18,
   "text": "סימנתם, אז סירבתם, נכון?"
  },
  {
   "id": "twist",
   "s": 6.58,
   "e": 9.2,
   "text": "טעות, בעצם הסכמתם."
  },
  {
   "id": "msg",
   "s": 9.52,
   "e": 16.68,
   "text": "שלילה כפולה מתבטלת; ״וגם אמת״ ו״או שקר״ משאירים את הפסוק כמו שהוא."
  },
  {
   "id": "neg",
   "s": 17.34,
   "e": 19.5,
   "text": "כל ״לא״ הופך את ערך האמת."
  },
  {
   "id": "nnp",
   "s": 21.176,
   "e": 22.66,
   "text": "¬¬p מתהפך פעמיים: שוב p."
  },
  {
   "id": "const",
   "s": 23.22,
   "e": 25.68,
   "text": "T תמיד אמת, F תמיד שקר."
  },
  {
   "id": "and_t",
   "s": 26.14,
   "e": 28.06,
   "text": "p וגם אמת: p."
  },
  {
   "id": "or_f",
   "s": 28.38,
   "e": 30.26,
   "text": "p או שקר: p."
  },
  {
   "id": "and_f",
   "s": 30.5,
   "e": 32.72,
   "text": "p וגם שקר: תמיד שקר."
  },
  {
   "id": "lead",
   "s": 33.1,
   "e": 34.36,
   "text": "ומה בתיבה שלנו..."
  },
  {
   "id": "payoff",
   "s": 34.86,
   "e": 37.82,
   "text": "שתי השלילות נמחקו, ונשארה הסכמה."
  },
  {
   "id": "recap",
   "s": 38.2,
   "e": 43.12,
   "text": "שלילה כפולה מתבטלת, ואמת ב״וגם״ ושקר ב״או״ נעלמים."
  },
  {
   "id": "loop",
   "s": 43.64,
   "e": 44.86,
   "text": "אז רגע, מה עושה"
  }
 ],
