{
 "lines": [
  {
   "id": "hook",
   "s": 0.0,
   "e": 3.0,
   "text": "שני מתגים למעלה. למה חושך?"
  },
  {
   "id": "rule",
   "s": 3.93,
   "e": 9.5,
   "text": "בחדר הזה אור כשאחד למעלה או השני, וגם לא שניהם."
  },
  {
   "id": "msg",
   "s": 10.69,
   "e": 17.94,
   "text": "פסוק מורכב מחשבים בחלקים: עמודה לכל חלק, מבפנים החוצה, והאחרונה היא התשובה."
  },
  {
   "id": "vars",
   "s": 18.83,
   "e": 23.02,
   "text": "p: מתג הדלת למעלה, q: מתג המיטה."
  },
  {
   "id": "inner",
   "s": 23.84,
   "e": 28.98,
   "text": "בלוח האמת, מבפנים: p או q, ו-p וגם q."
  },
  {
   "id": "outer",
   "s": 29.7,
   "e": 32.28,
   "text": "ואז השלילה, ובסוף הפסוק כולו."
  },
  {
   "id": "one",
   "s": 33.26,
   "e": 36.54,
   "text": "אחד למעלה? האחרונה אמת: אור."
  },
  {
   "id": "lead",
   "s": 37.16,
   "e": 40.72,
   "text": "ושניהם? ה״או״ אמת, אז אור?"
  },
  {
   "id": "payoff",
   "s": 41.52,
   "e": 47.26,
   "text": "ה״וגם״ אמת, השלילה שקר, והאחרונה שקר: חושך."
  },
  {
   "id": "recap",
   "s": 48.4,
   "e": 53.02,
   "text": "עמודה לכל חלק, מבפנים החוצה, והעמודה האחרונה היא התשובה."
  },
  {
   "id": "loop",
   "s": 53.92,
   "e": 55.42,
   "text": "וכשתיכנסו לחדר:"
  }
 ],
