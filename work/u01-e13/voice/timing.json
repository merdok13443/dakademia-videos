{
 "lines": [
  {
   "id": "hook",
   "s": 0.0,
   "e": 2.14,
   "text": "שני מתגים למעלה, למה חושך?"
  },
  {
   "id": "rule",
   "s": 3.48,
   "e": 7.04,
   "text": "כאן אור כשאחד למעלה או השני, וגם לא שניהם."
  },
  {
   "id": "msg",
   "s": 8.72,
   "e": 15.96,
   "text": "לוח אמת לפסוק מורכב נבנה עמודה לכל חלק, מבפנים החוצה, והעמודה האחרונה היא התשובה."
  },
  {
   "id": "vars",
   "s": 16.98,
   "e": 19.98,
   "text": "p: מתג הדלת למעלה, q: מתג המיטה."
  },
  {
   "id": "inner",
   "s": 20.6,
   "e": 25.96,
   "text": "בלוח האמת, מבפנים: p או q, ו-p וגם q."
  },
  {
   "id": "outer",
   "s": 26.36,
   "e": 28.99,
   "text": "ואז השלילה, ובסוף הפסוק כולו."
  },
  {
   "id": "one",
   "s": 30.0,
   "e": 33.04,
   "text": "כשאחד למעלה, האחרונה אמת: אור."
  },
  {
   "id": "lead",
   "s": 33.74,
   "e": 37.2,
   "text": "וכששניהם למעלה, ה״או״ אמת, אז אור?"
  },
  {
   "id": "payoff",
   "s": 38.08,
   "e": 42.68,
   "text": "ה״וגם״ אמת, השלילה שקר, והאחרונה שקר: חושך."
  },
  {
   "id": "recap",
   "s": 43.76,
   "e": 47.62,
   "text": "עמודה לכל חלק, מבפנים החוצה, והעמודה האחרונה היא התשובה."
  },
  {
   "id": "loop",
   "s": 48.64,
   "e": 50.08,
   "text": "וכשתיכנסו לחדר:"
  }
 ],
