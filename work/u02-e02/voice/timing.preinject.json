{
 "lines": [
  {
   "id": "hook",
   "s": 0.0,
   "e": 2.92,
   "text": "״שם המשתמש או הסיסמה שגויים״: שניהם שגויים?"
  },
  {
   "id": "need",
   "s": 3.38,
   "e": 6.7,
   "text": "כניסה דורשת שם נכון וגם סיסמה נכונה."
  },
  {
   "id": "fail",
   "s": 6.98,
   "e": 8.72,
   "text": "וכישלון הוא השלילה שלה."
  },
  {
   "id": "law",
   "s": 9.0,
   "e": 13.358,
   "text": "ואיך שוללים? חוק דה-מורגן."
  },
  {
   "id": "msg",
   "s": 11.88,
   "e": 17.8,
   "text": "כששוללים ״וגם״ מקבלים ״או״, וכששוללים ״או״ מקבלים ״וגם״; כל חלק נשלל בנפרד."
  },
  {
   "id": "form",
   "s": 18.3,
   "e": 22.364,
   "text": "כלומר: לא p, או לא q."
  },
  {
   "id": "row1",
   "s": 22.364,
   "e": 24.1,
   "text": "כש-p ו-q אמת, שני הצדדים שקר."
  },
  {
   "id": "rows",
   "s": 24.32,
   "e": 26.32,
   "text": "ובשאר, שני הצדדים אמת."
  },
  {
   "id": "trap",
   "s": 26.8,
   "e": 28.16,
   "text": "אז ״שניהם שגויים״?"
  },
  {
   "id": "pay",
   "s": 28.58,
   "e": 31.32,
   "text": "רק שורה אחת: מספיק שאחד שגוי."
  },
  {
   "id": "other",
   "s": 32.18,
   "e": 34.5,
   "text": "״שניהם שגויים״ זו שלילת ״p או q״."
  },
  {
   "id": "recap",
   "s": 35.16,
   "e": 39.04,
   "text": "בשלילה ״וגם״ ו״או״ מתחלפים, וכל חלק נשלל."
  },
  {
   "id": "loop",
   "s": 39.36,
   "e": 40.7,
   "text": "ולכן המסך כותב לך:"
  }
 ],
