{
 "lines": [
  {
   "id": "hook",
   "s": 0.0,
   "e": 3.28,
   "text": "ים המלח, המלוח ביותר בעולם. זה פסוק?"
  },
  {
   "id": "low",
   "s": 3.7,
   "e": 6.3,
   "text": "קודם: הנמוך ביותר ביבשה. אמת."
  },
  {
   "id": "msg",
   "s": 6.72,
   "e": 10.78,
   "text": "פסוק הוא משפט שהוא אמת או שקר, וגם משפט שקרי הוא פסוק."
  },
  {
   "id": "tv",
   "s": 11.26,
   "e": 14.62,
   "text": "ערך האמת: טי לאמת, אף לשקר."
  },
  {
   "id": "var",
   "s": 15.176,
   "e": 19.1,
   "text": "ואיקס ועוד אחת שווה שלוש? תלוי באיקס, לא פסוק."
  },
  {
   "id": "salt",
   "s": 19.66,
   "e": 22.36,
   "text": "והמלוח ביותר? אף, שקר."
  },
  {
   "id": "pond",
   "s": 22.56,
   "e": 24.18,
   "text": "בריכה באנטארקטיקה מלוחה ממנו."
  },
  {
   "id": "myth",
   "s": 24.88,
   "e": 26.22,
   "text": "אז זה לא פסוק?"
  },
  {
   "id": "pay",
   "s": 26.98,
   "e": 28.2,
   "text": "ועדיין, זה פסוק."
  },
  {
   "id": "tru",
   "s": 28.82,
   "e": 30.7,
   "text": "שתיים ועוד שלוש שווה חמש: טי."
  },
  {
   "id": "lt",
   "s": 31.26,
   "e": 34.46,
   "text": "שבע קטן מארבע: אף, וגם פסוק."
  },
  {
   "id": "recap",
   "s": 34.86,
   "e": 38.16,
   "text": "פסוק: אמת או שקר, וגם שקרי הוא פסוק."
  },
  {
   "id": "loop",
   "s": 38.74,
   "e": 39.44,
   "text": "אז תגידו לי:"
  }
