{
 "lines": [
  {
   "id": "hook",
   "s": 0.0,
   "e": 1.6,
   "text": "״כי״ זה קשר לוגי?"
  },
  {
   "id": "myth",
   "s": 2.3,
   "e": 4.46,
   "text": "נשמע שכן: הוא מחבר שני משפטים."
  },
  {
   "id": "msg",
   "s": 5.3,
   "e": 9.76,
   "text": "קשר לוגי: האמת של המשפט כולו נקבעת רק לפי האמת של חלקיו."
  },
  {
   "id": "a",
   "s": 10.24,
   "e": 12.28,
   "text": "בקיץ יש יותר אור. אמת."
  },
  {
   "id": "b",
   "s": 12.62,
   "e": 14.68,
   "text": "מזיזים את השעון. אמת."
  },
  {
   "id": "s1",
   "s": 15.34,
   "e": 18.12,
   "text": "בקיץ יש יותר אור כי מזיזים את השעון?"
  },
  {
   "id": "f",
   "s": 18.56,
   "e": 20.34,
   "text": "שקר. הסיבה הפוכה."
  },
  {
   "id": "s2",
   "s": 20.78,
   "e": 23.42,
   "text": "מזיזים את השעון כי בקיץ יש יותר אור."
  },
  {
   "id": "t",
   "s": 23.76,
   "e": 24.26,
   "text": "אמת."
  },
  {
   "id": "lead",
   "s": 24.92,
   "e": 27.44,
   "text": "אותם חלקים אמיתיים, ותוצאה הפוכה."
  },
  {
   "id": "pay",
   "s": 28.04,
   "e": 29.72,
   "text": "אז ״כי״ לא קשר לוגי."
  },
  {
   "id": "and",
   "s": 30.56,
   "e": 33.46,
   "text": "ב״וגם״, אמת ואמת תמיד נותנים אמת."
  },
  {
   "id": "recap",
   "s": 33.8,
   "e": 36.62,
   "text": "קשר לוגי: רק האמת של החלקים קובעת."
  },
  {
   "id": "loop",
   "s": 36.92,
   "e": 38.06,
   "text": "אז תמיד תשאלו:"
  }
 ],
