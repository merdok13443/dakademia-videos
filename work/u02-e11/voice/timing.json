{
 "lines": [
  {
   "id": "hook",
   "s": 0.0,
   "e": 3.52,
   "text": "הנוכחות חובה, ובעמוד הבא: אינה חובה."
  },
  {
   "id": "ask",
   "s": 3.98,
   "e": 4.78,
   "text": "מה נובע?"
  },
  {
   "id": "twist",
   "s": 5.58,
   "e": 8.9,
   "text": "הכול: שמגיע לך 100, וגם שלא."
  },
  {
   "id": "msg",
   "s": 9.62,
   "e": 14.6,
   "text": "מהנחות שסותרות זו את זו נובעת כל מסקנה, כי אין מצב שבו כולן אמת."
  },
  {
   "id": "def",
   "s": 15.4,
   "e": 19.26,
   "text": "נובע: אין מצב שההנחות אמת והמסקנה שקר."
  },
  {
   "id": "alone",
   "s": 19.86,
   "e": 23.18,
   "text": "מ-p לבד, q לא נובע: הנה מצב כזה."
  },
  {
   "id": "addnot",
   "s": 24.04,
   "e": 27.76,
   "text": "מוסיפים ¬p, ובכל שורה הנחה אחת שקר."
  },
  {
   "id": "gone",
   "s": 28.36,
   "e": 31.29,
   "text": "אין מצב כזה: q נובע, וגם ¬q."
  },
  {
   "id": "lead",
   "s": 32.34,
   "e": 33.34,
   "text": "מגיע לך 100?"
  },
  {
   "id": "payoff",
   "s": 34.18,
   "e": 36.28,
   "text": "הכול נובע, וכלום לא הוכח."
  },
  {
   "id": "recap",
   "s": 37.18,
   "e": 40.7,
   "text": "הנחות סותרות? כל מסקנה נובעת, ואחת שגויה."
  },
  {
   "id": "proof",
   "s": 41.86,
   "e": 43.0,
   "text": "ככה מוכיחים בשלילה."
  },
  {
   "id": "loop",
   "s": 43.46,
   "e": 45.5,
   "text": "ועכשיו, בחזרה לסילבוס:"
  }
