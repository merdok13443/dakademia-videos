{
 "lines": [
  {
   "id": "hook",
   "s": 0.0,
   "e": 4.0,
   "text": "מחפשים בתל אביב, מרפסת או חניה, ומקבלים דירה באילת?"
  },
  {
   "id": "msg",
   "s": 5.28,
   "e": 11.7,
   "text": "״וגם״ לבד, ״או״ לבד: הסדר והסוגריים חופשיים; כשמערבבים, מפלגים."
  },
  {
   "id": "swap",
   "s": 12.69,
   "e": 15.78,
   "text": "חילוף: מרפסת או חניה, זה חניה או מרפסת."
  },
  {
   "id": "group",
   "s": 16.24,
   "e": 19.96,
   "text": "קיבוץ: בשרשרת של וגם, הסוגריים זזים חופשי."
  },
  {
   "id": "mix",
   "s": 20.89,
   "e": 24.9,
   "text": "החיפוש מערבב: p וגם, בסוגריים, q או r."
  },
  {
   "id": "move",
   "s": 25.48,
   "e": 28.48,
   "text": "מזיזים סוגריים, ודירה באילת נכנסת."
  },
  {
   "id": "why",
   "s": 29.08,
   "e": 31.3,
   "text": "בלי תל אביב, חניה לבדה מספיקה."
  },
  {
   "id": "payoff",
   "s": 32.3,
   "e": 36.92,
   "text": "פילוג: p וגם q, או p וגם r."
  },
  {
   "id": "same",
   "s": 36.92,
   "e": 40.3,
   "text": "זהה לחיפוש שלנו, בכל שמונה השורות."
  },
  {
   "id": "recap",
   "s": 41.1,
   "e": 45.8,
   "text": "״וגם״ לבד, ״או״ לבד: חופשי; מערבבים, מפלגים."
  },
  {
   "id": "loop",
   "s": 46.28,
   "e": 48.86,
   "text": "אחרת, זה מה שקורה כשאתם"
  }
 ],
