{
 "lines": [
  {
   "id": "hook",
   "s": 0.0,
   "e": 4.52,
   "text": "מחפשים בתל אביב, מרפסת או חניה, ומקבלים דירה באילת?"
  },
  {
   "id": "msg",
   "s": 5.32,
   "e": 13.9,
   "text": "חילוף, קיבוץ ופילוג: רק וגם, או רק או, הסדר והסוגריים חופשיים; כשמערבבים, מה שבחוץ נכנס לשני הצדדים."
  },
  {
   "id": "familiar",
   "s": 14.7,
   "e": 18.38,
   "text": "חילוף וקיבוץ מוכרים: חניה או מרפסת, אותו חיפוש."
  },
  {
   "id": "mix",
   "s": 18.62,
   "e": 22.06,
   "text": "מערבבים: p וגם, בסוגריים, q או r."
  },
  {
   "id": "move",
   "s": 22.5,
   "e": 26.0,
   "text": "מזיזים סוגריים, ודירה באילת נכנסת."
  },
  {
   "id": "why",
   "s": 26.5,
   "e": 28.32,
   "text": "עכשיו, חניה לבדה מספיקה."
  },
  {
   "id": "payoff",
   "s": 29.32,
   "e": 33.64,
   "text": "פילוג: p נכנס לשני הצדדים, p וגם q, או p וגם r."
  },
  {
   "id": "same",
   "s": 34.24,
   "e": 35.94,
   "text": "זהה לחיפוש, בכל השורות."
  },
  {
   "id": "recap",
   "s": 36.74,
   "e": 40.26,
   "text": "״וגם״ לבד, ״או״ לבד: חופשי; מערבבים, מפלגים."
  },
  {
   "id": "loop",
   "s": 40.64,
   "e": 42.9,
   "text": "אחרת, זה מה שקורה כשאתם"
  }
 ],
