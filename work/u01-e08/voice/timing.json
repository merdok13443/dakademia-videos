{
 "lines": [
  {
   "id": "hook",
   "s": 0.0,
   "e": 4.22,
   "text": "נבחרת זוכה במונדיאל אם ורק אם מנצחת בכל המשחקים?"
  },
  {
   "id": "if",
   "s": 4.92,
   "e": 7.42,
   "text": "ה״אם״ ברור: מנצחת תמיד, זוכה."
  },
  {
   "id": "spain",
   "s": 7.9,
   "e": 10.5,
   "text": "ספרד, האלופה, פתחה בתיקו."
  },
  {
   "id": "onlyif",
   "s": 11.1,
   "e": 13.72,
   "text": "ה״רק אם״ נופל: שקר."
  },
  {
   "id": "msg",
   "s": 14.54,
   "e": 19.92,
   "text": "״אם ורק אם״ נכון כששני הכיוונים נכונים: גם ״אם״ וגם ״רק אם״."
  },
  {
   "id": "def",
   "s": 20.92,
   "e": 23.36,
   "text": "אם q אז p, וגם להפך."
  },
  {
   "id": "x4",
   "s": 24.4,
   "e": 26.96,
   "text": "x זוגי אם ורק אם מתחלק בארבע?"
  },
  {
   "id": "six",
   "s": 27.48,
   "e": 31.46,
   "text": "שש זוגי, לא מתחלק בארבע: ה״רק אם״ נופל. שקר."
  },
  {
   "id": "lead",
   "s": 33.7,
   "e": 36.477,
   "text": "ומתחלק בשתיים..."
  },
  {
   "id": "payoff",
   "s": 35.58,
   "e": 37.82,
   "text": "עכשיו ה״רק אם״ נכון: אמת."
  },
  {
   "id": "wc",
   "s": 38.74,
   "e": 42.06,
   "text": "ובמונדיאל: מנצחת בגמר? אמת."
  },
  {
   "id": "same",
   "s": 43.139,
   "e": 45.2,
   "text": "ל-p ול-q אותו ערך אמת."
  },
  {
   "id": "loop",
   "s": 46.2,
   "e": 48.88,
   "text": "בודקים גם ״אם״, וגם ״רק אם״:"
  }
 ],
