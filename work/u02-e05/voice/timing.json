{
 "lines": [
  {
   "id": "hook",
   "s": 0.0,
   "e": 3.62,
   "text": "מתי השלט ״אם חנית כאן, הרכב ייגרר״ משקר?"
  },
  {
   "id": "trap",
   "s": 4.62,
   "e": 6.87,
   "text": "נגרר מרחוב אחר? השלט לא שיקר."
  },
  {
   "id": "only",
   "s": 7.47,
   "e": 11.25,
   "text": "הוא משקר רק כשחנית, והרכב לא נגרר."
  },
  {
   "id": "or",
   "s": 12.05,
   "e": 16.989,
   "text": "כלומר: לא חנית כאן, או שהרכב ייגרר."
  },
  {
   "id": "msg",
   "s": 16.989,
   "e": 20.57,
   "text": "״אם־אז״ הוא בעצם ״או״: התנאי לא קרה, או שהתוצאה קרתה."
  },
  {
   "id": "nota",
   "s": 21.57,
   "e": 24.19,
   "text": "p גורר q, שקול ל־״לא p, או q״."
  },
  {
   "id": "rows",
   "s": 24.99,
   "e": 28.09,
   "text": "לשניהם: אמת, שקר, אמת, אמת."
  },
  {
   "id": "lead",
   "s": 29.09,
   "e": 32.921,
   "text": "...ומה השלילה של אם־אז?"
  },
  {
   "id": "payoff",
   "s": 32.5,
   "e": 35.28,
   "text": "בלי ״אם״ בכלל: p, וגם לא q."
  },
  {
   "id": "anchor",
   "s": 36.28,
   "e": 37.88,
   "text": "חנית, והרכב לא נגרר."
  },
  {
   "id": "recap",
   "s": 38.68,
   "e": 41.3,
   "text": "״אם p אז q״ זה ״לא p, או q״."
  },
  {
   "id": "loop",
   "s": 42.0,
   "e": 43.22,
   "text": "ועכשיו אתם יודעים"
  }
 ],
