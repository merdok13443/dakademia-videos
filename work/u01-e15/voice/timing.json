{
 "lines": [
  {
   "id": "h1",
   "s": 0.0,
   "e": 4.68,
   "text": "מכמה סוגי שערים בנויה הלוגיקה של המחשב שהגיע לירח?"
  },
  {
   "id": "r2",
   "s": 5.58,
   "e": 9.4,
   "text": "סוג אחד: שער NOR, קשר לוגי בחומרה."
  },
  {
   "id": "n3",
   "s": 10.28,
   "e": 15.479,
   "text": "NOR הוא ״לא-או״, ותאומו NAND: ״לא-וגם״."
  },
  {
   "id": "m4",
   "s": 15.38,
   "e": 20.98,
   "text": "קשר אחד מספיק: מ-NAND לבדו בונים את כל שאר הקשרים, וכך גם מ-NOR."
  },
  {
   "id": "d5",
   "s": 22.18,
   "e": 25.3,
   "text": "קשרים שבונים כל פסוק: מערכת שלמה."
  },
  {
   "id": "s6",
   "s": 26.38,
   "e": 28.32,
   "text": "שלילה: p NAND p."
  },
  {
   "id": "a7",
   "s": 29.06,
   "e": 32.18,
   "text": "הקשר ״וגם״: שוללים את p NAND q."
  },
  {
   "id": "l8",
   "s": 32.88,
   "e": 35.26,
   "text": "ורק הקשרים ״וגם״ ו״או״?"
  },
  {
   "id": "p9",
   "s": 36.16,
   "e": 38.98,
   "text": "יחד, הם אינם מערכת שלמה."
  },
  {
   "id": "w10",
   "s": 39.88,
   "e": 43.66,
   "text": "כשהכול אמת, יוצא רק אמת, ושלילה צריכה שקר."
  },
  {
   "id": "c12",
   "s": 44.54,
   "e": 47.66,
   "text": "קשר אחד מספיק: NAND, וכך גם NOR."
  },
  {
   "id": "o13",
   "s": 48.34,
   "e": 49.2,
   "text": "נחשו שוב:"
  }
 ],
